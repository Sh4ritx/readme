Este programa es una calculadora sencilla que permite realizar
las cuatro operaciones básicas: suma, resta, multiplicación y división.
Se creó como proyecto de práctica para el taller de Git y GitHub.
"""


def sumar(a, b):
    return a + b


def restar(a, b):
    return a - b


def multiplicar(a, b):
    return a * b


def dividir(a, b):
    # Controlamos el caso de división entre cero para que el programa
    # no se caiga con un error.
    if b == 0:
        print("Error: no se puede dividir entre cero.")
        return None
    return a / b


def pedir_numero(mensaje):
    """Pide un número al usuario y valida que realmente sea un número."""
    while True:
        try:
            return float(input(mensaje))
        except ValueError:
            print("Eso no es un número válido. Intenta de nuevo.")


def mostrar_menu():
    print("\n===== CALCULADORA =====")
    print("1. Sumar")
    print("2. Restar")
    print("3. Multiplicar")
    print("4. Dividir")
    print("5. Salir")


def main():
    print("Bienvenido a la calculadora del Taller de GitHub")

    while True:
        mostrar_menu()
        opcion = input("Elige una opción (1-5): ")

        if opcion == "5":
            print("Gracias por usar la calculadora. ¡Hasta luego!")
            break

        if opcion not in ("1", "2", "3", "4"):
            print("Opción no válida, intenta de nuevo.")
            continue

        num1 = pedir_numero("Ingresa el primer número: ")
        num2 = pedir_numero("Ingresa el segundo número: ")

        if opcion == "1":
            resultado = sumar(num1, num2)
            operacion = "+"
        elif opcion == "2":
            resultado = restar(num1, num2)
            operacion = "-"
        elif opcion == "3":
            resultado = multiplicar(num1, num2)
            operacion = "*"
        elif opcion == "4":
            resultado = dividir(num1, num2)
            operacion = "/"

        if resultado is not None:
            print(f"\nResultado: {num1} {operacion} {num2} = {resultado}")


if __name__ == "__main__":
    main()
